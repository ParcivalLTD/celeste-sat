# everything the tools build or download
build/
__pycache__/
*.egg-info/
*.cnf
*.smt2

# The game's own files are never committed: copy the map files from
# <Celeste>/Content/Maps into game/ (see game/README.md)
game/*
!game/README.md
*.bin

# rooms exported from your own copy of the game stay local (tests/chain_tas.py
# writes Chapter 1's) -- except Chapter 2's, which are committed for now
# (see ROADMAP.md, "Before going public")
rooms/vanilla/*
!rooms/vanilla/2a_*.txt
results/vanilla/

# decompiled game code (ILSpy output) is the game's, not ours: keep it out of the repository
*.cs
!tests/**/*.cs
# Everest / Celeste logs
log.txt
